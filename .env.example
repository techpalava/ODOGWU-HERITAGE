# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe API private key for processing genuine secure card/iDEAL deposits.
# If omitted or invalid, the applet operates in secure simulation mode.
STRIPE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Client Firebase web configuration (browser-visible)
# Copy EVERY VITE_FIREBASE_* value from the SAME staging Firebase Web app into
# an ignored `.env.local`. Do not combine staging and production values.
# Copying only a staging projectId while keeping a production authDomain,
# storageBucket, sender ID, app ID, API key, measurement ID, or database ID
# is rejected. Local `npm run dev` fails closed without a complete staging set.
# Never use the production project gen-lang-client-0614710868 here.
# VITE_* variables are bundled into the browser. Never put Admin private keys,
# tokens, or other server secrets in VITE_* values.
# -----------------------------------------------------------------------------
VITE_APP_ENV="staging"
VITE_FIREBASE_API_KEY="YOUR_STAGING_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_STAGING_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_STAGING_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STAGING_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_STAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_STAGING_WEB_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIRESTORE_DATABASE_ID=""

# -----------------------------------------------------------------------------
# Firebase Admin credentials: SERVER-ONLY
# Required by PIN login, legacy account migration, and custom-token endpoints
# outside Google Cloud. These are never read into the browser Firebase client
# configuration. Do not copy them into VITE_* variables. In AI Studio/Cloud Run,
# Application Default Credentials may be used instead.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="gen-lang-client-0614710868"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

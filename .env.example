# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe API private key for processing genuine secure card/iDEAL deposits.
# If omitted or invalid, the applet operates in secure simulation mode.
STRIPE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Client Firebase web configuration (browser-visible)
# The current Firebase project is PRE-LAUNCH STAGING, not production.
# Current staging project ID: gen-lang-client-0614710868
# Copy EVERY VITE_FIREBASE_* value from the SAME staging Firebase Web app into
# an ignored `.env.local`. You may copy the existing committed staging Web app
# (see firebase-applet-config.json) or another complete staging Web app.
# Do not mix fields from different Firebase projects or Web apps.
# Local `npm run dev` fails closed without a complete staging set.
# No production Firebase project exists yet. Create one separately before launch.
# VITE_* variables are bundled into the browser. Never put Admin private keys,
# tokens, or other server secrets in VITE_* values.
# -----------------------------------------------------------------------------
VITE_APP_ENV="staging"
VITE_FIREBASE_API_KEY="YOUR_STAGING_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_STAGING_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_STAGING_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STAGING_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_STAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_STAGING_WEB_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIRESTORE_DATABASE_ID=""

# -----------------------------------------------------------------------------
# Firebase Admin credentials: SERVER-ONLY staging example
# Required by PIN login, legacy account migration, and custom-token endpoints
# outside Google Cloud. These are never read into the browser Firebase client
# configuration. Do not copy them into VITE_* variables.
# Use the current staging project ID (gen-lang-client-0614710868) only for
# staging Admin routes. A production Admin project does not exist yet.
# In AI Studio/Cloud Run, Application Default Credentials may be used instead.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="<STAGING_PROJECT_ID>"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

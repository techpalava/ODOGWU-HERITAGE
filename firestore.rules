rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsDocumentPath(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function hasValidFutureDraftLifecycle(data) {
      return data.lifecycleStatus == "active"
        || data.lifecycleStatus == "cleared";
    }

    function hasValidFutureDraftPayload(draft) {
      return draft is map
        && draft.journeySchemaVersion == 1
        && draft.currentStageId is string
        && draft.currentStageId in [
          "garment_type",
          "fabric",
          "design_style",
          "custom_details",
          "try_on",
          "measurement",
          "summary",
          "shipping",
          "payment"
        ];
    }

    function hasValidFutureDraftShape(data) {
      return data.schemaVersion == 1
        && data.revision is int
        && data.revision > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && hasValidFutureDraftLifecycle(data)
        && data.keys().hasOnly([
          "schemaVersion",
          "lifecycleStatus",
          "revision",
          "createdAt",
          "updatedAt",
          "draft"
        ])
        && data.keys().hasAll([
          "schemaVersion",
          "lifecycleStatus",
          "revision",
          "createdAt",
          "updatedAt"
        ])
        && (
          (
            data.lifecycleStatus == "active"
            && data.keys().hasAll(["draft"])
            && hasValidFutureDraftPayload(data.draft)
          )
          || (
            data.lifecycleStatus == "cleared"
            && !data.keys().hasAny(["draft"])
          )
        );
    }

    match /fabrics/{fabricId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fabric_drafts/{document=**} {
      allow read, write: if isAdmin();
    }

    match /styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /showpieces/{showpieceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPhotos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customGroups/{groupId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncomingDocument();
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["currentMembers"])
        );
      allow delete: if isAdmin() || ownsExistingDocument();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || ownsExistingDocument();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.canonicalEmail == resource.data.canonicalEmail
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "phone",
            "location",
            "orderStatus",
            "method",
            "measurementProfile",
            "measurementProfiles",
            "biometricConsent"
          ])
        );
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || ownsExistingDocument();
      allow create: if isAdmin()
        || (
          ownsIncomingDocument()
          && request.resource.data.customer.ownerUid == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([])
        );
      allow delete: if isAdmin();
    }

    match /businessSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reference_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_detail_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /futureDesignStudioDrafts/{ownerUid} {
      allow read: if isAdmin() || ownsDocumentPath(ownerUid);
      allow create: if (isAdmin() || ownsDocumentPath(ownerUid))
        && hasValidFutureDraftShape(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin() || ownsDocumentPath(ownerUid))
        && hasValidFutureDraftShape(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

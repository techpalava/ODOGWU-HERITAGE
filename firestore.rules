rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /fabrics/{fabricId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fabric_drafts/{document=**} {
      allow read, write: if isAdmin();
    }

    match /styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /showpieces/{showpieceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPhotos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customGroups/{groupId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncomingDocument();
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["currentMembers"])
        );
      allow delete: if isAdmin() || ownsExistingDocument();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || ownsExistingDocument();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.canonicalEmail == resource.data.canonicalEmail
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "phone",
            "location",
            "orderStatus",
            "method",
            "measurementProfile",
            "measurementProfiles",
            "biometricConsent"
          ])
        );
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || ownsExistingDocument();
      allow create: if isAdmin()
        || (
          ownsIncomingDocument()
          && request.resource.data.customer.ownerUid == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([])
        );
      allow delete: if isAdmin();
    }

    match /businessSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reference_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_detail_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

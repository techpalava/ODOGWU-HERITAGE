rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsDocumentPath(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isFutureOrderV2(data) {
      return (
          data.keys().hasAll(["schemaVersion"])
          && data.schemaVersion == 2
        )
        || (
          data.keys().hasAll(["recordType"])
          && data.recordType == "future_order_v2"
        );
    }

    function hasValidFutureDraftLifecycle(data) {
      return data.lifecycleStatus == "active"
        || data.lifecycleStatus == "cleared";
    }

    function hasValidFutureDraftPayload(draft) {
      return draft is map
        && draft.journeySchemaVersion == 1
        && draft.currentStageId is string
        && draft.currentStageId in [
          "garment_type",
          "fabric",
          "design_style",
          "custom_details",
          "try_on",
          "measurement",
          "summary",
          "shipping",
          "payment"
        ];
    }

    function hasValidFutureDraftShape(data) {
      return data.schemaVersion == 1
        && data.revision is int
        && data.revision > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && hasValidFutureDraftLifecycle(data)
        && data.keys().hasOnly([
          "schemaVersion",
          "lifecycleStatus",
          "revision",
          "createdAt",
          "updatedAt",
          "draft"
        ])
        && data.keys().hasAll([
          "schemaVersion",
          "lifecycleStatus",
          "revision",
          "createdAt",
          "updatedAt"
        ])
        && (
          (
            data.lifecycleStatus == "active"
            && data.keys().hasAll(["draft"])
            && hasValidFutureDraftPayload(data.draft)
          )
          || (
            data.lifecycleStatus == "cleared"
            && !data.keys().hasAny(["draft"])
          )
        );
    }

    function hasValidDesignStyleLifecycle(data) {
      return data.lifecycle == "draft"
        || data.lifecycle == "published"
        || data.lifecycle == "disabled"
        || data.lifecycle == "archived";
    }

    function hasValidDesignStylePresentation(data) {
      return data is map
        && data.keys().hasOnly([
          "name",
          "description",
          "image",
          "displayOrder",
          "gender",
          "outfitType",
          "garmentComposition",
          "fabricCategory",
          "options",
          "designCategories",
          "detectedColors",
          "constructionDetails",
          "customDetailConfiguration",
          "includedDesignFeatures",
          "monogramCuffEligible",
          "embroideryProminence",
          "defaultGarmentDetails"
        ])
        && data.keys().hasAll([
          "name",
          "description",
          "image",
          "displayOrder",
          "gender",
          "outfitType",
          "garmentComposition",
          "fabricCategory",
          "options",
          "designCategories",
          "detectedColors",
          "constructionDetails",
          "customDetailConfiguration",
          "includedDesignFeatures",
          "monogramCuffEligible",
          "embroideryProminence",
          "defaultGarmentDetails"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.description is string
        && data.description.size() <= 2000
        && data.image is string
        && data.image.size() <= 3000
        && data.displayOrder is int
        && data.displayOrder >= 0
        && data.gender in ["male", "female", "unisex", "couple", "family"]
        && data.outfitType is string
        && data.garmentComposition is string
        && data.fabricCategory is string
        && data.options is list
        && data.options.size() <= 100
        && data.designCategories is list
        && data.designCategories.size() <= 100
        && data.detectedColors is map
        && data.detectedColors.keys().hasOnly(["main", "secondary"])
        && data.detectedColors.keys().hasAll(["main", "secondary"])
        && data.detectedColors.main is string
        && data.detectedColors.secondary is string
        && data.constructionDetails is list
        && data.constructionDetails.size() <= 100
        && data.customDetailConfiguration is map
        && data.customDetailConfiguration.keys().hasOnly([
          "supportedGarmentGroups",
          "requiredSelectionGroups",
          "enabled"
        ])
        && data.customDetailConfiguration.keys().hasAll([
          "supportedGarmentGroups",
          "requiredSelectionGroups",
          "enabled"
        ])
        && data.customDetailConfiguration.supportedGarmentGroups is list
        && data.customDetailConfiguration.requiredSelectionGroups is list
        && data.customDetailConfiguration.enabled is bool
        && data.includedDesignFeatures is map
        && data.includedDesignFeatures.keys().hasOnly([
          "hasMonogram",
          "hasEmbroidery",
          "hasMonogramTrimming",
          "hasLining",
          "hasNet"
        ])
        && data.includedDesignFeatures.keys().hasAll([
          "hasMonogram",
          "hasEmbroidery",
          "hasMonogramTrimming"
        ])
        && data.includedDesignFeatures.hasMonogram is bool
        && data.includedDesignFeatures.hasEmbroidery is bool
        && data.includedDesignFeatures.hasMonogramTrimming is bool
        && (
          !data.includedDesignFeatures.keys().hasAny(["hasLining"])
          || data.includedDesignFeatures.hasLining is bool
        )
        && (
          !data.includedDesignFeatures.keys().hasAny(["hasNet"])
          || data.includedDesignFeatures.hasNet is bool
        )
        && data.monogramCuffEligible is bool
        && data.embroideryProminence in ["standard", "heavy"]
        && data.defaultGarmentDetails is map;
    }

    function hasValidDesignStyleEligibility(data) {
      return data is map
        && data.keys().hasOnly([
          "garmentTypes",
          "demographics",
          "adaptability"
        ])
        && data.keys().hasAll([
          "garmentTypes",
          "demographics",
          "adaptability"
        ])
        && data.garmentTypes is list
        && data.garmentTypes.hasOnly([
          "shirt",
          "trouser",
          "skirt",
          "standard_shorts",
          "bum_shorts",
          "dress",
          "kaftan",
          "full_length_gown",
          "agbada"
        ])
        && data.demographics is list
        && data.demographics.hasOnly(["male", "female"])
        && data.adaptability is map
        && data.adaptability.keys().hasOnly([
          "mode",
          "garmentTypes",
          "demographics"
        ])
        && data.adaptability.keys().hasAll([
          "mode",
          "garmentTypes",
          "demographics"
        ])
        && data.adaptability.mode in ["exact_only", "adaptable"]
        && data.adaptability.garmentTypes is list
        && data.adaptability.garmentTypes.hasOnly([
          "shirt",
          "trouser",
          "skirt",
          "standard_shorts",
          "bum_shorts",
          "dress",
          "kaftan",
          "full_length_gown",
          "agbada"
        ])
        && data.adaptability.demographics is list
        && data.adaptability.demographics.hasOnly(["male", "female"])
        && (
          (
            data.adaptability.mode == "exact_only"
            && data.adaptability.garmentTypes.size() == 0
            && data.adaptability.demographics.size() == 0
          )
          || (
            data.adaptability.mode == "adaptable"
            && data.adaptability.garmentTypes.size() > 0
          )
        );
    }

    function hasValidDesignStyleReferenceComposition(data) {
      return data is map
        && data.keys().hasOnly(["status", "garmentTypes"])
        && data.keys().hasAll(["status", "garmentTypes"])
        && data.status in ["known", "legacy_unresolved"]
        && data.garmentTypes is list
        && data.garmentTypes.hasOnly([
          "shirt",
          "trouser",
          "skirt",
          "standard_shorts",
          "bum_shorts",
          "dress",
          "kaftan",
          "full_length_gown",
          "agbada"
        ])
        && (
          (data.status == "known" && data.garmentTypes.size() > 0)
          || (
            data.status == "legacy_unresolved"
            && data.garmentTypes.size() == 0
          )
        );
    }

    function hasValidDesignStyleRecord(data) {
      return data is map
        && data.keys().hasOnly([
          "schemaVersion",
          "id",
          "lifecycle",
          "publicRevision",
          "eligibilityRevision",
          "eligibilityFingerprint",
          "presentation",
          "eligibility",
          "referenceComposition"
        ])
        && data.keys().hasAll([
          "schemaVersion",
          "id",
          "lifecycle",
          "publicRevision",
          "eligibilityRevision",
          "eligibilityFingerprint",
          "presentation",
          "eligibility",
          "referenceComposition"
        ])
        && data.schemaVersion == 1
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && hasValidDesignStyleLifecycle(data)
        && data.publicRevision is int
        && data.publicRevision > 0
        && data.eligibilityRevision is int
        && data.eligibilityRevision > 0
        && data.eligibilityFingerprint is string
        && data.eligibilityFingerprint.size() > 0
        && data.eligibilityFingerprint.size() <= 128
        && hasValidDesignStylePresentation(data.presentation)
        && hasValidDesignStyleEligibility(data.eligibility)
        && hasValidDesignStyleReferenceComposition(data.referenceComposition)
        && (
          data.lifecycle != "published"
          || (
            data.eligibility.garmentTypes.size() > 0
            && data.eligibility.demographics.size() > 0
          )
        );
    }

    function hasValidDesignStyleCreate(styleId) {
      return hasValidDesignStyleRecord(request.resource.data)
        && request.resource.data.id == styleId
        && request.resource.data.publicRevision == 1
        && request.resource.data.eligibilityRevision == 1;
    }

    function hasDesignStyleAuthorityEnvelope(data) {
      return data is map
        && data.keys().hasAll([
          "schemaVersion",
          "id",
          "publicRevision",
          "eligibilityRevision",
          "eligibilityFingerprint",
          "eligibility"
        ])
        && data.schemaVersion == 1
        && data.id is string
        && data.publicRevision is int
        && data.eligibilityRevision is int
        && data.eligibilityFingerprint is string
        && data.eligibility is map;
    }

    function isExplicitLegacyDesignStyleMigration(styleId) {
      return resource.data is map
        && !hasDesignStyleAuthorityEnvelope(resource.data)
        && !resource.data.keys().hasAny([
          "schemaVersion",
          "lifecycle",
          "publicRevision",
          "eligibilityRevision",
          "eligibilityFingerprint",
          "presentation",
          "eligibility",
          "referenceComposition"
        ])
        && resource.data.id == styleId
        && resource.data.fabricCapacityComposition is list
        && resource.data.fabricCapacityComposition.size() > 0;
    }

    function hasValidDesignStyleUpdate(styleId) {
      return hasValidDesignStyleRecord(request.resource.data)
        && request.resource.data.id == styleId
        && (
          (
            hasDesignStyleAuthorityEnvelope(resource.data)
            && resource.data.id == styleId
            && request.resource.data.id == resource.data.id
            && request.resource.data.schemaVersion == resource.data.schemaVersion
            && request.resource.data.publicRevision == resource.data.publicRevision + 1
            && (
              (
                request.resource.data.eligibility == resource.data.eligibility
                && request.resource.data.eligibilityRevision == resource.data.eligibilityRevision
                && request.resource.data.eligibilityFingerprint == resource.data.eligibilityFingerprint
              )
              || (
                request.resource.data.eligibility != resource.data.eligibility
                && request.resource.data.eligibilityRevision == resource.data.eligibilityRevision + 1
                && request.resource.data.eligibilityFingerprint != resource.data.eligibilityFingerprint
              )
            )
          )
          || (
            isExplicitLegacyDesignStyleMigration(styleId)
            && request.resource.data.publicRevision == 1
            && request.resource.data.eligibilityRevision == 1
          )
        );
    }

    match /fabrics/{fabricId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fabric_drafts/{document=**} {
      allow read, write: if isAdmin();
    }

    match /styles/{styleId} {
      allow get: if isAdmin()
        || (
          hasValidDesignStyleRecord(resource.data)
          && resource.data.lifecycle == "published"
        );
      // Firestore list authorization must be provable from the public query.
      // Strict nested validation is enforced on every Admin mutation and again
      // by the customer projection before a snapshot becomes authoritative.
      allow list: if isAdmin()
        || (
          resource.data.schemaVersion == 1
          && resource.data.lifecycle == "published"
        );
      allow create: if isAdmin() && hasValidDesignStyleCreate(styleId);
      allow update: if isAdmin() && hasValidDesignStyleUpdate(styleId);
      allow delete: if false;
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /showpieces/{showpieceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPhotos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private Batch records use an immutable document ID plus stable Firebase
    // UIDs. A display name, inviteCode field from historical records, and
    // currentMembers are never authorization authorities.
    function isPublicCustomGroup(data) {
      return data.visibility == "PUBLIC";
    }

    function isPrivateCustomGroup(data) {
      return data.visibility == "PRIVATE";
    }

    function isCustomGroupOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function privateBatchMembership(groupId) {
      return get(/databases/$(database)/documents/customGroups/$(groupId)/privateBatchMembers/$(request.auth.uid));
    }

    function isPrivateCustomGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/customGroups/$(groupId)/privateBatchMembers/$(request.auth.uid))
        && privateBatchMembership(groupId).data.memberUid == request.auth.uid
        && privateBatchMembership(groupId).data.groupId == groupId
        && privateBatchMembership(groupId).data.role == "member";
    }

    function hasPrivateBatchLimits(data) {
      let limits = get(/databases/$(database)/documents/settings/business).data.batchSettings;
      return limits.minParticipantsRequired is int
        && limits.maxGarmentsPerBatch is int
        && data.expectedParticipants >= limits.minParticipantsRequired
        && data.expectedParticipants <= data.maxParticipants
        && data.maxParticipants <= limits.maxGarmentsPerBatch;
    }

    // These fields describe the durable Private Batch itself. They must carry
    // meaningful values at the rules boundary because the creation UI is not
    // an authorization boundary.
    function hasMeaningfulPrivateBatchText(value, maximumLength) {
      return value is string
        && value.size() > 0
        // Firestore Rules uses RE2 syntax. Require one non-whitespace code
        // point so direct writes cannot bypass the service's trim boundary.
        && !value.matches("^\\s*$")
        && value.size() <= maximumLength;
    }

    // Owner lifecycle edits are intentionally one-way once registration has
    // closed. Server/admin work retains its existing privileged authority.
    function hasAllowedPrivateBatchOwnerStatusTransition(previous, next) {
      return previous == next
        || (
          previous == "DRAFT"
          && next in ["OPEN", "CLOSED", "LOCKED"]
        )
        || (
          previous in ["OPEN", "ALMOST_FULL"]
          && next in ["ALMOST_FULL", "FULL", "CLOSED", "LOCKED", "COMPLETED"]
        )
        || (
          previous == "FULL"
          && next in ["CLOSED", "LOCKED", "COMPLETED"]
        )
        || (
          previous == "CLOSED"
          && next in ["LOCKED", "COMPLETED"]
        );
    }

    function hasPrivateBatchShape(data, groupId) {
      return groupId.matches("^[A-Za-z0-9_-]{16,128}$")
        && data.keys().hasAll([
          "schemaVersion",
          "batchId",
          "ownerUid",
          "organizerId",
          "organizer",
          "batchName",
          "occasion",
          "description",
          "country",
          "city",
          "preferredDeliveryMonth",
          "expectedParticipants",
          "maxParticipants",
          "visibility",
          "currentMembers",
          "closingDate",
          "deliveryWindow",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "schemaVersion",
          "batchId",
          "ownerUid",
          "organizerId",
          "organizer",
          "batchName",
          "occasion",
          "description",
          "country",
          "city",
          "preferredDeliveryMonth",
          "expectedParticipants",
          "maxParticipants",
          "visibility",
          "currentMembers",
          "closingDate",
          "deliveryWindow",
          "status",
          "pickupLocation",
          "notes",
          "createdAt",
          "updatedAt"
        ])
        && data.schemaVersion == 1
        && data.batchId is string
        && data.batchId == groupId
        && data.ownerUid is string
        && data.organizerId is string
        && hasMeaningfulPrivateBatchText(data.organizer, 160)
        && hasMeaningfulPrivateBatchText(data.batchName, 160)
        && hasMeaningfulPrivateBatchText(data.occasion, 160)
        && hasMeaningfulPrivateBatchText(data.description, 2000)
        && hasMeaningfulPrivateBatchText(data.country, 160)
        && hasMeaningfulPrivateBatchText(data.city, 160)
        && hasMeaningfulPrivateBatchText(data.preferredDeliveryMonth, 160)
        && data.expectedParticipants is int
        && data.maxParticipants is int
        && data.currentMembers is int
        && data.currentMembers >= 1
        && data.currentMembers <= data.maxParticipants
        && data.visibility == "PRIVATE"
        && hasMeaningfulPrivateBatchText(data.closingDate, 160)
        && hasMeaningfulPrivateBatchText(data.deliveryWindow, 160)
        && data.status in ["DRAFT", "OPEN", "ALMOST_FULL", "FULL", "CLOSED", "LOCKED", "COMPLETED"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidPrivateBatchCreate(groupId) {
      return isSignedIn()
        && hasPrivateBatchShape(request.resource.data, groupId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.currentMembers == 1
        && request.resource.data.status in ["DRAFT", "OPEN"]
        && hasPrivateBatchLimits(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidPrivateBatchOwnerUpdate(groupId) {
      return isCustomGroupOwner(resource.data)
        // The incoming complete document is validated below. Re-running the
        // full shape (including every text regex) against the immutable
        // stored document exceeds the Rules evaluator budget on a merge
        // update without adding authorization authority.
        && hasPrivateBatchShape(request.resource.data, groupId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.batchId == resource.data.batchId
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.currentMembers == resource.data.currentMembers
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && hasPrivateBatchLimits(request.resource.data)
        && hasAllowedPrivateBatchOwnerStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "batchName",
          "occasion",
          "description",
          "country",
          "city",
          "preferredDeliveryMonth",
          "expectedParticipants",
          "maxParticipants",
          "closingDate",
          "deliveryWindow",
          "status",
          "pickupLocation",
          "notes",
          "updatedAt"
        ]);
    }

    match /customGroups/{groupId} {
      allow get: if isAdmin()
        || isPublicCustomGroup(resource.data)
        || isCustomGroupOwner(resource.data)
        || isPrivateCustomGroupMember(groupId);
      // Public discovery must query visibility == PUBLIC. Owner discovery must
      // query ownerUid == request.auth.uid. Members discover their own
      // UID-keyed member documents and then get exact group documents.
      allow list: if isAdmin()
        || isPublicCustomGroup(resource.data)
        || isCustomGroupOwner(resource.data);
      allow create: if isAdmin()
        || hasValidPrivateBatchCreate(groupId)
        || (
          isSignedIn()
          && isPublicCustomGroup(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.batchId == groupId
        );
      allow update: if isAdmin()
        || (
          isPublicCustomGroup(resource.data)
          && (
            (
              isCustomGroupOwner(resource.data)
              && isPublicCustomGroup(request.resource.data)
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.batchId == resource.data.batchId
            )
            || (
              isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["currentMembers"])
            )
          )
        )
        || (
          isPrivateCustomGroup(resource.data)
          && hasValidPrivateBatchOwnerUpdate(groupId)
        );
      // Private Batch deletion needs a server-side cleanup transaction once
      // member documents exist. This foundation therefore fails closed for
      // organizers instead of leaving orphaned authorization records.
      allow delete: if isAdmin()
        || (isPublicCustomGroup(resource.data) && isCustomGroupOwner(resource.data));
    }

    // The recursive match is required for the collection-group membership
    // query. The dedicated name avoids granting access to other domains'
    // generic "members" subcollections.
    match /{path=**}/privateBatchMembers/{memberUid} {
      allow get: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == memberUid
          && resource.data.memberUid == memberUid
          && resource.data.role == "member"
        );
      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.memberUid == request.auth.uid
          && resource.data.role == "member"
        );
      // Only the authenticated server transaction may grant, revoke, or alter
      // membership. Client writes cannot forge a Private Batch role.
      allow create, update, delete: if false;
    }

    // Tokens are high-entropy server secrets. They are never queryable or
    // readable from the client; the server transaction resolves their hash.
    match /privateBatchInvites/{inviteId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || ownsExistingDocument();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.canonicalEmail == resource.data.canonicalEmail
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "phone",
            "location",
            "orderStatus",
            "method",
            "measurementProfile",
            "measurementProfiles",
            "biometricConsent"
          ])
        );
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || ownsExistingDocument();
      // New canonical V2 orders are only persisted through the authenticated
      // server/Admin SDK boundary, which checks private-batch membership in
      // the same transaction. Retain only the legacy client path here.
      allow create: if !isFutureOrderV2(request.resource.data)
        && (
          isAdmin()
          || (
          ownsIncomingDocument()
          && request.resource.data.customer.ownerUid == request.auth.uid
          )
        );
      allow update: if !isFutureOrderV2(resource.data)
        && !isFutureOrderV2(request.resource.data)
        && (
          isAdmin()
          || (
          ownsExistingDocument()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([])
          )
        );
      allow delete: if !isFutureOrderV2(resource.data)
        && isAdmin();
    }

    match /businessSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reference_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_detail_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staffPreviewEntitlements/{ownerUid} {
      allow get: if ownsDocumentPath(ownerUid);
      allow list, create, update, delete: if false;
    }

    match /futureDesignStudioDrafts/{ownerUid} {
      allow read: if isAdmin() || ownsDocumentPath(ownerUid);
      allow create: if (isAdmin() || ownsDocumentPath(ownerUid))
        && hasValidFutureDraftShape(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin() || ownsDocumentPath(ownerUid))
        && hasValidFutureDraftShape(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
